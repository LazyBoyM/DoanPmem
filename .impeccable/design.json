      "css": ".ds-label{display:block;margin-bottom:7px;font:600 .9375rem var(--font-family, 'Source Sans 3', 'Segoe UI', sans-serif);color:#46545f}.ds-field{display:block;width:calc(100% - 26px);min-height:42px;padding:9px 12px;background:var(--card-bg, #fff);color:var(--text-main, #292f35);border:1px solid var(--field-border, #c8d1d7);border-radius:6px;font:400 .9375rem var(--font-family, 'Source Sans 3', 'Segoe UI', sans-serif)}.ds-field::placeholder{color:#65727b}.ds-field:hover{border-color:var(--field-border, #c8d1d7)}.ds-field:focus{border-color:var(--primary, #247d8b);box-shadow:0 0 0 3px #247d8b16}.ds-field:disabled{background:#f0f3f5;color:#61707b}.ds-control:focus-visible{outline:2px solid var(--primary, #247d8b);outline-offset:3px}"
