PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=training_management
DB_PORT=3306
JWT_SECRET=super_secret_jwt_key_for_training_system_2026
USE_MOCK_IF_NO_DB=true
# DB_MODE=mock is an explicit local demo; never allowed in production.
# DB_MODE=mysql
# NODE_ENV=production
# Production requires a unique JWT_SECRET (at least 32 characters) and MySQL.

# Cloud connection: DATABASE_URL takes precedence over DB_HOST/USER/PASSWORD/NAME/PORT.
# DATABASE_URL=mysql://USER:URL_ENCODED_PASSWORD@HOST:4000/DATABASE
# Set options below, not in DATABASE_URL query parameters.
# DB_SSL=true
# Certificate verification is enabled by default and required in production/Vercel.
# DB_SSL_CA_PATH=/absolute/path/to/ca.pem
# Alternatively DB_SSL_CA contains the PEM certificate itself (cloud environment).
# DB_CONNECTION_LIMIT=2
# On Vercel set DB_MODE=mysql, USE_MOCK_IF_NO_DB=false and a unique JWT_SECRET.
